<?xml version="1.0" encoding="utf-8"?>
<!-- Generated layout: glass section cards, inline segmented choices, notes only where a row needs one. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_bg">

<com.gathin.tvhome.GlassScrollView
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="40dp"
        android:paddingBottom="56dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <LinearLayout
            style="@style/SettingsBlock"
            android:layout_marginTop="22dp">
            <TextView
                android:id="@+id/reorderChoice"
                style="@style/SettingsRow"
                android:text="@string/reorder" />
        </LinearLayout>

        <TextView
            style="@style/SettingsSection"
            android:text="@string/sec_look" />
        <LinearLayout
            style="@style/SettingsCard">
            <LinearLayout
                android:id="@+id/segTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                style="@style/SettingsBlock">
                <TextView
                    android:id="@+id/wallpaperChoice"
                    style="@style/SettingsRow" />
                <TextView
                    style="@style/SettingsNote"
                    android:text="@string/d_wallpaper" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/segDaily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/segWallOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/segBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                style="@style/SettingsBlock"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/dock_opacity_label" />
                </LinearLayout>
                <LinearLayout
                    style="@style/SettingsSegments">
                    <TextView android:id="@+id/dock100" style="@style/SettingsSeg" android:text="100%" />
                    <TextView android:id="@+id/dock70" style="@style/SettingsSeg" android:text="70%" />
                    <TextView android:id="@+id/dock50" style="@style/SettingsSeg" android:text="50%" />
                    <TextView android:id="@+id/dock30" style="@style/SettingsSeg" android:text="30%" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/segAnimations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/segAdvanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/segGlass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/segGlide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/segResume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
        <TextView
            style="@style/SettingsSection"
            android:text="@string/sec_grid" />
        <LinearLayout
            style="@style/SettingsCard">
            <LinearLayout
                style="@style/SettingsBlock"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/columns_label" />
                </LinearLayout>
                <LinearLayout
                    style="@style/SettingsSegments">
                    <TextView android:id="@+id/columns4" style="@style/SettingsSeg" android:text="4" />
                    <TextView android:id="@+id/columns5" style="@style/SettingsSeg" android:text="5" />
                    <TextView android:id="@+id/columns6" style="@style/SettingsSeg" android:text="6" />
                    <TextView android:id="@+id/columns7" style="@style/SettingsSeg" android:text="7" />
                    <TextView android:id="@+id/columns8" style="@style/SettingsSeg" android:text="8" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                style="@style/SettingsBlock"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/rows_below_dock_label" />
                </LinearLayout>
                <LinearLayout
                    style="@style/SettingsSegments">
                    <TextView android:id="@+id/rows0" style="@style/SettingsSeg" android:text="0" />
                    <TextView android:id="@+id/rows1" style="@style/SettingsSeg" android:text="1" />
                    <TextView android:id="@+id/rows2" style="@style/SettingsSeg" android:text="2" />
                    <TextView android:id="@+id/rows3" style="@style/SettingsSeg" android:text="3" />
                    <TextView android:id="@+id/rows4" style="@style/SettingsSeg" android:text="4" />
                    <TextView android:id="@+id/rows5" style="@style/SettingsSeg" android:text="5" />
                    <TextView android:id="@+id/rows6" style="@style/SettingsSeg" android:text="6" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/segLift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
        <TextView
            style="@style/SettingsSection"
            android:text="@string/sec_apps" />
        <LinearLayout
            style="@style/SettingsCard">
            <LinearLayout
                android:id="@+id/segSort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                style="@style/SettingsBlock">
                <TextView
                    android:id="@+id/hiddenChoice"
                    style="@style/SettingsRow"
                    android:text="@string/hidden_apps" />
                <TextView
                    style="@style/SettingsNote"
                    android:text="@string/d_hidden" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/togglesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
        <TextView
            style="@style/SettingsSection"
            android:text="@string/sec_buttons" />
        <LinearLayout
            style="@style/SettingsCard">
            <LinearLayout
                android:id="@+id/buttonsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/pillsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/segWifiName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                style="@style/SettingsBlock">
                <TextView
                    android:id="@+id/vpnChoice"
                    style="@style/SettingsRow" />
                <TextView
                    style="@style/SettingsNote"
                    android:text="@string/d_vpn" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            style="@style/SettingsSection"
            android:text="@string/sec_weather" />
        <LinearLayout
            style="@style/SettingsCard">
            <LinearLayout
                style="@style/SettingsBlock">
                <TextView
                    android:id="@+id/weatherKeyChoice"
                    style="@style/SettingsRow" />
                <TextView
                    style="@style/SettingsNote"
                    android:text="@string/d_weather_key" />
            </LinearLayout>
            <LinearLayout
                style="@style/SettingsBlock">
                <TextView
                    android:id="@+id/weatherCityChoice"
                    style="@style/SettingsRow" />
                <TextView
                    style="@style/SettingsNote"
                    android:text="@string/d_weather_city" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/segUnits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
        <TextView
            style="@style/SettingsSection"
            android:text="@string/sec_data" />
        <LinearLayout
            style="@style/SettingsCard">
            <LinearLayout
                style="@style/SettingsBlock">
                <TextView
                    android:id="@+id/backupChoice"
                    style="@style/SettingsRow"
                android:text="@string/backup" />
                <TextView
                    style="@style/SettingsNote"
                    android:text="@string/d_backup" />
            </LinearLayout>
            <LinearLayout
                style="@style/SettingsBlock">
                <TextView
                    android:id="@+id/restoreChoice"
                    style="@style/SettingsRow"
                android:text="@string/restore" />
                <TextView
                    style="@style/SettingsNote"
                    android:text="@string/d_restore" />
            </LinearLayout>
            <LinearLayout
                style="@style/SettingsBlock">
                <TextView
                    android:id="@+id/followThemeChoice"
                    style="@style/SettingsRow"
                android:text="@string/follow_theme" />
                <TextView
                    style="@style/SettingsNote"
                    android:text="@string/d_follow" />
            </LinearLayout>
            <LinearLayout
                style="@style/SettingsBlock">
                <TextView
                    android:id="@+id/resetChoice"
                    style="@style/SettingsRow"
                android:text="@string/reset_defaults" />
                <TextView
                    style="@style/SettingsNote"
                    android:text="@string/d_reset" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            style="@style/SettingsSection"
            android:text="@string/sec_system" />
        <LinearLayout
            style="@style/SettingsCard">
            <LinearLayout
                android:id="@+id/segLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                style="@style/SettingsBlock">
                <TextView
                    android:id="@+id/defaultHomeChoice"
                    style="@style/SettingsRow"
                android:text="@string/home_settings" />
                <TextView
                    android:id="@+id/homeNote"
                    style="@style/SettingsNote"
                    android:text="@string/d_home" />
            </LinearLayout>
            <LinearLayout
                style="@style/SettingsBlock">
                <TextView
                    android:id="@+id/tvSettingsChoice"
                    style="@style/SettingsRow"
                android:text="@string/tv_settings" />
                <TextView
                    style="@style/SettingsNote"
                    android:text="@string/d_tv" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.gathin.tvhome.GlassScrollView>

</FrameLayout>
