<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass pill tinted on: same frosted gradient and hairline as pill_bg, with a soft colour wash. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#8034C759" android:endColor="#5C34C759" />
            <stroke android:width="1dp" android:color="#CC5BE585" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
