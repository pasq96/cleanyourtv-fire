<?xml version="1.0" encoding="utf-8"?>
<!-- Deep blue field with a soft glow top left, so the glass cards have something to refract. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF070D1A" android:endColor="#FF1B2F57" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.12" android:centerY="0.0"
                android:gradientRadius="75%p" android:startColor="#403D7BFF" android:endColor="#003D7BFF" />
        </shape>
    </item>
</layer-list>
